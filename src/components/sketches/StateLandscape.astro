---
// Melanoma cell states drawn as valleys: a cell interprets a drug, stress, and signals from the tumor microenvironment
// (TME) through its gene regulatory network (GRN; AP-1 in this project), which helps determine where it settles
// between drug-sensitive and drug-tolerant.
import RoughFilter from './RoughFilter.astro';
import { arrowhead } from './geometry';

// The network inside the cell: T regulates L and R, and L → R → B → L closes a feedback loop.
const nodes = { T: [140, 33], L: [124, 48], R: [156, 48], B: [140, 63] } as const;
type Node = keyof typeof nodes;
const links: [Node, Node][] = [['T', 'L'], ['T', 'R'], ['L', 'R'], ['R', 'B'], ['B', 'L']];
const nodeRadius = 3.5;
const inset = nodeRadius + 1.4;
const edges = links.map(([from, to]) => {
  const [x1, y1] = nodes[from];
  const [x2, y2] = nodes[to];
  const length = Math.hypot(x2 - x1, y2 - y1);
  const [ux, uy] = [(x2 - x1) / length, (y2 - y1) / length];
  const [sx, sy] = [+(x1 + ux * inset).toFixed(1), +(y1 + uy * inset).toFixed(1)];
  const [ex, ey] = [+(x2 - ux * inset).toFixed(1), +(y2 - uy * inset).toFixed(1)];
  return { line: `M${sx} ${sy} L${ex} ${ey}`, head: arrowhead(ex, ey, sx, sy, 4) };
});
---
<svg class="sketch" viewBox="0 0 280 180" role="img" aria-label="Sketch of a cell receiving three inputs: a drug, stress, and signals from the tumor microenvironment, drawn as an immune cell and a fibroblast. The cell interprets them through a gene regulatory network, and arrows lead from the cell to three valleys in a landscape, states that range from drug-sensitive to drug-tolerant.">
  <defs>
    <RoughFilter id="rough-landscape" seed={4} />
    <!-- A gentler wobble for the small network, so its arrowheads stay legible. -->
    <RoughFilter id="rough-network" seed={4} scale={1.2} />
    <linearGradient id="state-spectrum" gradientUnits="userSpaceOnUse" x1="76" y1="0" x2="204" y2="0">
      <stop offset="0" class="sk-stop-blue" />
      <stop offset="0.5" class="sk-stop-green" />
      <stop offset="1" class="sk-stop-warm" />
    </linearGradient>
  </defs>
  <g filter="url(#rough-landscape)">
    <!-- Inputs: a drug and stress from the left, the TME (an immune cell and a fibroblast) from the right. -->
    <rect class="sk-line sk-fill-paper" x="14" y="24" width="30" height="13" rx="6.5" />
    <path class="sk-fill-warm-solid" d="M29 24.5 H37.5 A6 6 0 0 1 37.5 36.5 H29 Z" />
    <path class="sk-line" d="M29 24.5 V36.5" />
    <path class="sk-line" d="M50 31 C74 31 92 36 110 44" />
    <path class="sk-line" d={arrowhead(110, 44, 92, 37)} />
    <path class="sk-line sk-thin sk-warm sk-fill-warm" d="M32 74 L22 88 H29 L26 99 L37 83 H30 Z" />
    <path class="sk-line" d="M44 85 C68 84 92 74 110 65" />
    <path class="sk-line" d={arrowhead(110, 65, 93, 72)} />
    <path class="sk-line sk-thin sk-green sk-fill-green" d="M208 46 C211 40 219 40 221 44 C226 43 229 49 226 53 C229 58 223 63 218 61 C214 65 206 62 207 57 C202 54 203 47 208 46 Z" />
    <circle class="sk-fill-green-solid" cx="216" cy="52" r="3.2" />
    <path class="sk-line sk-thin sk-green sk-fill-green" d="M234 70 C241 62 252 56 266 53 C259 62 248 68 234 70 Z" />
    <ellipse class="sk-fill-green-solid" cx="250" cy="62" rx="3.4" ry="2" transform="rotate(-22 250 62)" />
    <path class="sk-line" d="M199 52 H172" />
    <path class="sk-line" d={arrowhead(172, 52, 184, 52)} />

    <!-- The cell, whose gene regulatory network (drawn below) interprets those inputs. -->
    <circle class="sk-line" cx="140" cy="54" r="29" />

    <!-- Possible outcomes: states drawn as valleys, on a spectrum from drug-sensitive to drug-tolerant. -->
    <path class="sk-line sk-dash" d="M120 75 C102 96 72 104 56 122" />
    <path class="sk-line" d={arrowhead(56, 122, 70, 108)} />
    <path class="sk-line sk-dash" d="M140 85 V121" />
    <path class="sk-line" d={arrowhead(140, 121, 140, 105)} />
    <path class="sk-line sk-dash" d="M160 75 C178 96 208 104 224 122" />
    <path class="sk-line" d={arrowhead(224, 122, 210, 108)} />
    <path class="sk-line" d="M5 114 C30 114 30 150 50 150 C70 150 76 114 95 114 C114 114 120 150 140 150 C160 150 166 114 185 114 C204 114 210 150 230 150 C250 150 250 114 275 114" />
    <circle class="sk-line sk-blue sk-fill-blue" cx="50" cy="140" r="9" />
    <circle class="sk-dot-blue" cx="52" cy="138" r="2.5" />
    <circle class="sk-line sk-green sk-fill-green" cx="140" cy="140" r="9" />
    <circle class="sk-dot-green" cx="142" cy="138" r="2.5" />
    <circle class="sk-line sk-warm sk-fill-warm" cx="230" cy="140" r="9" />
    <circle class="sk-dot-warm" cx="232" cy="138" r="2.5" />
    <path class="sk-spectrum" stroke="url(#state-spectrum)" d="M76 167 H204" />
  </g>
  <g filter="url(#rough-network)">
    {edges.map(({ line, head }) => (
      <>
        <path class="sk-line sk-thin sk-muted" d={line} />
        <path class="sk-line sk-thin sk-muted" d={head} />
      </>
    ))}
    {Object.values(nodes).map(([cx, cy]) => <circle class="sk-line sk-thin sk-fill-paper" cx={cx} cy={cy} r={nodeRadius} />)}
  </g>
  <text x="29" y="16" text-anchor="middle" class="sk-label">drug</text>
  <text x="29" y="66" text-anchor="middle" class="sk-label">stress</text>
  <text x="232" y="33" text-anchor="middle" class="sk-label">TME</text>
  <text x="140" y="78.5" text-anchor="middle" class="sk-label sk-small">GRN</text>
  <text x="68" y="171.5" text-anchor="end" class="sk-label">sensitive</text>
  <text x="212" y="171.5" class="sk-label sk-strong">tolerant</text>
</svg>
