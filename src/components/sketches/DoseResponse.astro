---
// Drug synergy as a left-shifted dose-response curve: the combination reaches the same effect at a lower dose.
import RoughFilter from './RoughFilter.astro';
import { arrowhead, doseResponse } from './geometry';
const alone = doseResponse(44, 264, 196, 148, 112, 11);
const together = doseResponse(44, 264, 112, 148, 112, 11);
---
<svg class="sketch" viewBox="0 0 280 180" role="img" aria-label="Sketch of two dose-response curves. The curve for two drugs together sits to the left of the curve for one drug alone, so the combination reaches the same effect at a lower dose, labeled synergy.">
  <defs><RoughFilter id="rough-dose" seed={7} /></defs>
  <g filter="url(#rough-dose)">
    <path class="sk-line sk-muted" d="M38 18 V150 H268" />
    <path class="sk-line sk-muted" d={arrowhead(38, 14, 38, 30, 6)} />
    <path class="sk-line sk-muted" d={arrowhead(270, 150, 254, 150, 6)} />
    <path class="sk-line sk-muted sk-dash" d={alone} />
    <path class="sk-line sk-blue sk-thick" d={together} />
    <path class="sk-line sk-warm" d="M190 92 H122" />
    <path class="sk-line sk-warm" d={arrowhead(120, 92, 134, 92, 7)} />
  </g>
  <text x="154" y="84" text-anchor="middle" class="sk-label sk-strong">synergy</text>
  <text x="148" y="27" text-anchor="middle" class="sk-label sk-strong">together</text>
  <text x="244" y="27" text-anchor="middle" class="sk-label">alone</text>
  <text x="152" y="172" text-anchor="middle" class="sk-label">dose</text>
  <text x="24" y="84" text-anchor="middle" class="sk-label" transform="rotate(-90 24 84)">effect</text>
</svg>
