---
// One drug combination tested against three isolates of one species, each shown as a small isobologram:
// bowed toward the origin (synergy) for isolates 1 and 2, straight (no synergy) for isolate 3.
import RoughFilter from './RoughFilter.astro';
import { arrowhead } from './geometry';

// A small isobologram centred on cx: axes, the additive line, and either a synergy curve or a straight line.
const plots = [
  { cx: 56, synergy: true },
  { cx: 140, synergy: true },
  { cx: 224, synergy: false },
].map(({ cx, synergy }) => ({
  synergy,
  axes: `M${cx - 22} 70 V114 H${cx + 26}`,
  additive: `M${cx - 22} 76 L${cx + 22} 114`,
  curve: `M${cx - 22} 76 C${cx - 19} 102 ${cx - 6} 112 ${cx + 22} 114`,
}));
---
<svg class="sketch" viewBox="0 0 280 180" role="img" aria-label="Sketch of one drug combination tested against three isolates of the same bacterial species. Small isobolograms show that the combination is synergistic against isolates 1 and 2 but not against isolate 3.">
  <defs><RoughFilter id="rough-isolates" seed={2} /></defs>
  <g filter="url(#rough-isolates)">
    <rect class="sk-line sk-fill-paper" x="112" y="12" width="56" height="20" rx="10" />
    <path class="sk-fill-blue-solid" d="M122 12.5 H140 V31.5 H122 A9.5 9.5 0 0 1 122 12.5 Z" />
    <path class="sk-fill-warm-solid" d="M140 12.5 H158 A9.5 9.5 0 0 1 158 31.5 H140 Z" />
    <rect class="sk-line" x="112" y="12" width="56" height="20" rx="10" />
    <path class="sk-line" d="M140 12 V32" />
    <path class="sk-line sk-muted" d="M126 36 L72 60 M140 36 V58 M154 36 L208 60" />
    <path class="sk-line sk-muted" d={arrowhead(72, 60, 86, 54, 7)} />
    <path class="sk-line sk-muted" d={arrowhead(140, 60, 140, 46, 7)} />
    <path class="sk-line sk-muted" d={arrowhead(208, 60, 194, 54, 7)} />
    {plots.map(({ synergy, axes, additive, curve }) => (
      <>
        <path class="sk-line sk-thin sk-muted" d={axes} />
        {synergy ? (
          <>
            <path class="sk-line sk-thin sk-muted sk-dash" d={additive} />
            <path class="sk-line sk-blue" d={curve} />
          </>
        ) : (
          <path class="sk-line sk-warm" d={additive} />
        )}
      </>
    ))}
  </g>
  <text x="104" y="27" text-anchor="end" class="sk-label sk-small">same combination</text>
  <text x="56" y="138" text-anchor="middle" class="sk-label">isolate 1</text>
  <text x="140" y="138" text-anchor="middle" class="sk-label">isolate 2</text>
  <text x="224" y="138" text-anchor="middle" class="sk-label">isolate 3</text>
  <text x="56" y="158" text-anchor="middle" class="sk-label sk-small">synergy</text>
  <text x="140" y="158" text-anchor="middle" class="sk-label sk-small">synergy</text>
  <text x="224" y="158" text-anchor="middle" class="sk-label sk-strong">no synergy</text>
</svg>
