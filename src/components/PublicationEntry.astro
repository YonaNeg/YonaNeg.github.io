---
import type { Publication } from '../data/publications';
import { withBase } from '../utils/paths';
interface Props { publication: Publication; }
const { publication } = Astro.props;
const { figure, highlight, coFirstAuthors = [] } = publication;
// Wide figures are too small to read in the side column, so they sit below the text.
const wideFigure = !!figure && figure.width / figure.height > 1.6;
---

<article
  class:list={['publication-entry', { 'publication-entry-with-figure': !!figure && !wideFigure, 'publication-entry-wide-figure': wideFigure }]}
  aria-labelledby={'publication-' + publication.id}
>
  {figure && (
    <figure class="publication-figure">
      <a href={withBase(figure.src)} target="_blank" rel="noopener noreferrer" aria-label={'View full-size figure for ' + publication.title}>
        <img src={withBase(figure.src)} alt={figure.alt} width={figure.width} height={figure.height} loading="lazy" decoding="async" />
        <span class="figure-caption">View full-size figure</span>
      </a>
      {figure.credit && (
        <figcaption class="figure-credit">
          {figure.credit.text} · <a href={figure.credit.licenseHref} target="_blank" rel="noopener noreferrer">{figure.credit.license}</a>
        </figcaption>
      )}
    </figure>
  )}
  <div class="publication-body">
    <h3 id={'publication-' + publication.id}>
      <a href={publication.links[0].href} target="_blank" rel="noopener noreferrer">{publication.title}</a>
    </h3>
    <p class="authors">
      {publication.authors.map((author, index) => (
        <>{index > 0 ? ', ' : ''}{author === 'Degefu YN' ? <strong>{author}</strong> : author}{coFirstAuthors.includes(author) ? '*' : ''}</>
      ))}
    </p>
    <p class="paper-venue"><em>{publication.venue}</em>, {publication.year}; {publication.citation}</p>
    {highlight && (
      <p class="paper-highlight">
        {highlight.note} <a href={highlight.href} target="_blank" rel="noopener noreferrer">“{highlight.title}”</a>
      </p>
    )}
    <p class="paper-summary">{publication.summary}</p>
    <div class="pub-links">
      {publication.links.map(({ label, href }) => (
        <a href={href} target="_blank" rel="noopener noreferrer">{label}</a>
      ))}
    </div>
    {coFirstAuthors.length > 0 && <p class="note">*Co-first authors</p>}
  </div>
</article>
