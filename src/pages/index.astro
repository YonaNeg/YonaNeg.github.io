---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/yonatan-degefu.jpeg';
import StateLandscape from '../components/sketches/StateLandscape.astro';
import Isobologram from '../components/sketches/Isobologram.astro';
import DecisionTree from '../components/sketches/DecisionTree.astro';
import { publications } from '../data/publications';
import { withBase } from '../utils/paths';

// Each card is a one-line teaser; the full story lives in the matching section of the research page.
const questions = [
  { title: 'Why genetically identical cancer cells respond differently', summary: 'How cancer cells switch between states, and how the mix of states already present shapes their response to drugs and other signals.', anchor: 'melanoma', Sketch: StateLandscape },
  { title: 'Which drugs to combine, and at what dose', summary: 'Simulations that compare drug combinations and doses to suggest which are worth testing.', anchor: 'drug-combinations', Sketch: Isobologram },
  { title: 'Turning predictions into rules', summary: 'Machine learning that isn’t a black box: simple rules for assembling drug combinations, derived from the same measurements the model uses to predict.', anchor: 'tuberculosis', Sketch: DecisionTree },
];

const authorRole = ({ authors, coFirstAuthors = [] }: (typeof publications)[number]) =>
  authors[0] === 'Degefu YN' ? 'First author' : coFirstAuthors.includes('Degefu YN') ? 'Co-first author' : undefined;
const selectedPublications = publications.filter(({ selected }) => selected);
---
<BaseLayout title="Yonatan N. Degefu | Biomedical Engineering & Computational Biology">
  <section class="academic-intro academic-intro-with-portrait" aria-labelledby="home-title">
    <div class="intro-copy">
      <h1 id="home-title">Yonatan N. Degefu</h1>
      <p class="academic-role">PhD Candidate in Biomedical Engineering</p>
      <p class="academic-affiliation">University of Virginia · Fallahi-Sichani Lab</p>
      <div class="intro-bio">
        <p class="intro-lede">I use quantitative, systems-level approaches to understand complex biological systems, and to gain insight into when and why therapies fail and how they can be improved.</p>
        <p class="intro-summary">I build mechanistic models to explain how these systems behave and use interpretable machine learning to find which measurements predict outcomes, working with experimental data that range from single-cell measurements to large drug-combination screens.</p>
      </div>
      <nav class="academic-links" aria-label="Contact and academic profiles">
        <a class="button" href={withBase('/files/cv.pdf')} target="_blank" rel="noopener noreferrer">CV (PDF)</a>
        <a href="mailto:njr7jk@virginia.edu">Email</a>
        <a href="https://www.linkedin.com/in/yonatan-degefu-b16955a9/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://scholar.google.com/citations?user=POp9Bk4AAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>
      </nav>
    </div>
    <div class="portrait-frame">
      <Image src={portrait} alt="Yonatan N. Degefu" width={480} format="webp" quality={85} loading="eager" fetchpriority="high" class="profile-portrait" />
    </div>
  </section>

  <section class="home-section" aria-labelledby="research-questions">
    <div class="section-heading">
      <h2 id="research-questions">Questions I work on</h2>
      <a href={withBase('/research/')}>More on my research</a>
    </div>
    <div class="question-grid">
      {questions.map(({ title, summary, anchor, Sketch }) => (
        <article class="question-card">
          <div class="sketch-frame"><Sketch /></div>
          <h3><a href={withBase('/research/') + '#' + anchor}>{title}</a></h3>
          <p>{summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section" aria-labelledby="selected-publications">
    <div class="section-heading">
      <h2 id="selected-publications">Selected publications</h2>
      <a href={withBase('/publications/')}>All publications</a>
    </div>
    <ol class="pub-compact">
      {selectedPublications.map((publication) => {
        const role = authorRole(publication);
        return (
          <li>
            <a class="pub-compact-title" href={publication.links[0].href} target="_blank" rel="noopener noreferrer">{publication.title}</a>
            <p class="pub-compact-meta">
              <em>{publication.venue}</em> · {publication.year}{role && <> · <span class="pub-role">{role}</span></>}
              {publication.highlight && <> · <a href={publication.highlight.href} target="_blank" rel="noopener noreferrer">{publication.highlight.note.replace(/:$/, '')}</a></>}
            </p>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>
