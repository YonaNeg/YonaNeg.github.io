---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/yonatan-degefu.jpeg';
import PublicationEntry from '../components/PublicationEntry.astro';
import { publications } from '../data/publications';
import { withBase } from '../utils/paths';
const selectedPublications = publications.filter(({ selected }) => selected);
---
<BaseLayout title="Yonatan N. Degefu | Biomedical Engineering & Computational Biology">
  <section class="academic-intro academic-intro-with-portrait" aria-labelledby="home-title">
    <div class="intro-copy">
      <h1 id="home-title">Yonatan N. Degefu</h1>
      <p class="academic-role">PhD Candidate in Biomedical Engineering</p>
      <p class="academic-affiliation">University of Virginia · Fallahi-Sichani Lab</p>
      <div class="intro-bio">
        <p>I study how transcription factor networks regulate cellular plasticity in melanoma. My research combines mechanistic modeling, single-cell imaging, and network inference to understand cell state transitions and drug response.</p>
        <p>More broadly, I am interested in using quantitative approaches to connect molecular mechanisms with therapeutic outcomes, including the design of drug combinations for cancer and infectious diseases.</p>
      </div>
      <nav class="academic-links" aria-label="Contact and academic profiles">
        <a href="mailto:njr7jk@virginia.edu">Email</a>
        <a href="https://scholar.google.com/citations?user=POp9Bk4AAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>
        <a href={withBase('/files/cv.pdf')} target="_blank" rel="noopener noreferrer">CV (PDF)</a>
        <a href="https://www.linkedin.com/in/yonatan-degefu-b16955a9/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </nav>
    </div>
    <div class="portrait-frame">
      <Image src={portrait} alt="Yonatan N. Degefu" width={480} format="webp" quality={85} loading="eager" fetchpriority="high" class="profile-portrait" />
    </div>
  </section>

  <section class="home-section" aria-labelledby="selected-publications">
    <div class="section-heading">
      <h2 id="selected-publications">Selected publications</h2>
      <a href={withBase('/publications/')}>All publications</a>
    </div>
    <div class="paper-list">
      {selectedPublications.map((publication) => <PublicationEntry publication={publication} />)}
    </div>
  </section>

  <section class="home-section" aria-labelledby="research-heading">
    <div class="section-heading"><h2 id="research-heading">Research interests</h2><a href={withBase('/research/')}>Research details</a></div>
    <dl class="research-list">
      <div><dt>Computational cancer biology</dt><dd>AP-1 transcription factor networks, melanoma plasticity, and mechanistic models of cell state transitions.</dd></div>
      <div><dt>Quantitative systems pharmacology</dt><dd>Models of drug response and combination therapies for cancer and infectious diseases.</dd></div>
      <div><dt>Single-cell analysis & network inference</dt><dd>Multiplexed imaging, Boolean modeling, and regulatory network analysis.</dd></div>
    </dl>
  </section>

  <section class="home-section" aria-labelledby="experience-heading">
    <div class="section-heading"><h2 id="experience-heading">Selected experience & awards</h2></div>
    <ul class="milestones">
      <li><span class="date">2025</span><span>Walter H. Coulter Translational Research Fellowship, University of Virginia</span></li>
      <li><span class="date">2025</span><span>Systems Medicine Internship, AstraZeneca</span></li>
      <li><span class="date">2023</span><span>T32 Systems & Biomolecular Data Science Fellowship, University of Virginia</span></li>
    </ul>
  </section>
</BaseLayout>
