---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/yonatan-degefu.jpeg';
import PublicationEntry from '../components/PublicationEntry.astro';
import { publications } from '../data/publications';
import { withBase } from '../utils/paths';
const selectedPublications = publications.filter(({ selected }) => selected);
---
<BaseLayout title="Yonatan N. Degefu | Biomedical Engineering & Computational Biology">
  <section class="academic-intro academic-intro-with-portrait" aria-labelledby="home-title">
    <div class="intro-copy">
      <h1 id="home-title">Yonatan N. Degefu</h1>
      <p class="academic-role">PhD Candidate in Biomedical Engineering</p>
      <p class="academic-affiliation">University of Virginia · Fallahi-Sichani Lab</p>
      <div class="intro-bio">
        <p class="intro-lede">I use quantitative, systems-level approaches to understand complex biological systems and help turn that understanding into better therapies for patients.</p>
        <ul class="intro-approaches">
          <li><strong>Why treatments stop working.</strong> I build mechanistic models, calibrated to experimental data, to understand how cancer cells adapt and escape therapy, even without new mutations.</li>
          <li><strong>Which drugs to combine, and at what dose.</strong> I use simulations and efficient experimental designs to compare drug combinations and dosing strategies, so the most promising options are tested first.</li>
          <li><strong>Who is likely to benefit.</strong> I use interpretable machine learning to predict treatment outcomes and pinpoint the measurements behind each prediction. Those measurements are where biomarkers start: signals that could help match patients to the treatments most likely to work.</li>
        </ul>
        <p class="intro-next"><a href={withBase('/research/')}>Explore the questions behind my research</a> · <a href={withBase('/about/')}>Where I want to take this next</a></p>
      </div>
      <nav class="academic-links" aria-label="Contact and academic profiles">
        <a href="mailto:njr7jk@virginia.edu">Email</a>
        <a href="https://scholar.google.com/citations?user=POp9Bk4AAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>
        <a href={withBase('/files/cv.pdf')} target="_blank" rel="noopener noreferrer">CV (PDF)</a>
        <a href="https://www.linkedin.com/in/yonatan-degefu-b16955a9/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </nav>
    </div>
    <div class="portrait-frame">
      <Image src={portrait} alt="Yonatan N. Degefu" width={480} format="webp" quality={85} loading="eager" fetchpriority="high" class="profile-portrait" />
    </div>
  </section>

  <section class="home-section" aria-labelledby="selected-publications">
    <div class="section-heading">
      <h2 id="selected-publications">Selected publications</h2>
      <a href={withBase('/publications/')}>All publications</a>
    </div>
    <div class="paper-list">
      {selectedPublications.map((publication) => <PublicationEntry publication={publication} />)}
    </div>
  </section>

</BaseLayout>
