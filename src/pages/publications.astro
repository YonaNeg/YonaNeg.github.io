---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { publications } from '../data/publications';
const articles = publications.filter(({ kind }) => kind === 'journal');
const chapters = publications.filter(({ kind }) => kind === 'chapter');
---

<BaseLayout title="Publications - Yonatan N. Degefu" description="Research publications by Yonatan N. Degefu on AP-1 networks, melanoma plasticity, and drug combinations for infectious diseases.">
  <div class="publications-container">
    <p class="eyebrow page-kicker">Papers & methods</p>
    <h1>Publications</h1>
    <p class="intro">You can also find my articles on <a href="https://scholar.google.com/citations?user=POp9Bk4AAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>. Select a graphical abstract to view the full-size figure.</p>
    <section class="publications-section" aria-labelledby="journal-articles">
      <h2 id="journal-articles">Journal articles</h2>
      {articles.map((publication) => <PublicationEntry publication={publication} />)}
    </section>
    <section class="publications-section" aria-labelledby="methods-chapters">
      <h2 id="methods-chapters">Methods & book chapters</h2>
      {chapters.map((publication) => <PublicationEntry publication={publication} />)}
    </section>
    <section class="stats" aria-labelledby="collection-heading">
      <h2 id="collection-heading">In this collection</h2>
      <div class="stats-grid">
        <div class="stat-card"><h3>{publications.length}</h3><p>Listed works</p></div>
        <div class="stat-card"><h3>{articles.length}</h3><p>Journal articles</p></div>
        <div class="stat-card"><h3>{chapters.length}</h3><p>Methods chapter</p></div>
      </div>
    </section>
  </div>
</BaseLayout>
