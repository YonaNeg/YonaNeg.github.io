---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout title="Education - Yonatan N. Degefu" description="Education of Yonatan N. Degefu at the University of Virginia and Colby-Sawyer College.">
  <div class="cv-container">
    <div class="cv-header">
      <h1>Education</h1>
      <a href={withBase('/files/cv.pdf')} class="download-btn" download="Yonatan-Degefu-CV-2026.pdf">Download CV (PDF)</a>
    </div>
    <div class="education-list">
      <article class="cv-item">
        <div class="cv-main">
          <h2 class="degree-title">PhD in Biomedical Engineering</h2>
          <p class="institution">University of Virginia, Charlottesville, VA</p>
        </div>
        <p class="cv-date">August 2021 – Present</p>
      </article>
      <article class="cv-item">
        <div class="cv-main">
          <h2 class="degree-title">BS in Biology</h2>
          <p class="institution">Colby-Sawyer College, New London, NH</p>
          <p class="details">Minors: Mathematics & Chemistry · Summa Cum Laude</p>
        </div>
        <p class="cv-date">September 2014 – May 2018</p>
      </article>
    </div>
  </div>
</BaseLayout>
